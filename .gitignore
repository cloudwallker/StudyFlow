# Local configuration; sanitized examples remain versioned
.env
.env.*
!.env.example
!.env.*.example
/.local/
/docs/.local/

# Databases, journals and backup files (not backup source code or docs)
*.db
*.db-wal
*.db-shm
*.db-journal
