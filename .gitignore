*.sqlite3-shm
*.sqlite3-journal
*.sqlite3.sha256
*.bak
*.backup
/backups/

# Private signing material; public certificates require content review
*.pfx
*.p12
*.key
id_rsa
id_ed25519
*-private.pem
*.private.pem
private-key.pem

# Personal tool state; keep shared AGENTS.md and project tool configuration
